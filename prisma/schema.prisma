generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  support
  admin
  super_admin
}

enum UserStatus {
  active
  suspended
}

enum SubStatus {
  active
  canceled
  past_due
  incomplete
}

enum BillingInterval {
  month
  year
}

enum ToolSource {
  youtube
  tiktok
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  googleId        String?   @unique
  role            Role      @default(user)
  status          UserStatus @default(active)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subscriptions    Subscription[]
  usageDaily       UsageDaily[]
  tagGenerations   TagGeneration[]
  keywordSearches  KeywordSearch[]
  savedKeywords    SavedKeyword[]
  keywordLists     KeywordList[]
  rankChecks       RankCheck[]
  revenueReports   RevenueReport[]
  trendSearches    TrendSearch[]
  videoOptimizations VideoOptimization[]
  channelAudits    ChannelAudit[]
  hashtagGenerations HashtagGeneration[]
  bestUploadTimes    BestUploadTime[]
  channelComparisons ChannelComparison[]
  breakoutVideos     BreakoutVideo[]
  topCreatorsSearches TopCreatorsSearch[]
  auditLogs        AuditLog[]
  blogPosts        BlogPost[]
  notifications    Notification[]

  @@map("users")
}

model Plan {
  id                     String   @id @default(cuid())
  name                   String
  slug                   String   @unique
  description            String?
  priceMonthly           Int      // in paise (smallest INR unit)
  priceYearly            Int      // in paise (smallest INR unit)
  tagGenLimit            Int
  keywordSearchLimit     Int
  rankCheckLimit         Int
  revenueReportLimit     Int      @default(5)
  trendsResearchLimit    Int      @default(20)
  videoOptimizationLimit Int      @default(20)
  channelAuditLimit      Int      @default(10)
  hashtagGenLimit        Int      @default(20)
  uploadTimeLimit        Int      @default(10)
  channelComparisonLimit Int      @default(10)
  breakoutVideoLimit     Int      @default(10)
  topCreatorsLimit       Int      @default(10)
  featuresJson           Json     @default("{}")
  isActive               Boolean  @default(true)

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String          @id @default(cuid())
  userId               String
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  razorpayOrderId      String?         @unique
  razorpayPaymentId    String?
  amountMinorUnits     Int?
  currency             String          @default("INR")
  planId               String
  plan                 Plan            @relation(fields: [planId], references: [id])
  status               SubStatus       @default(active)
  billingInterval      BillingInterval @default(month)
  currentPeriodEnd     DateTime?
  createdAt            DateTime        @default(now())

  @@index([userId])
  @@map("subscriptions")
}

model UsageDaily {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                DateTime @db.Date
  tagGenCount         Int      @default(0)
  keywordSearchCount  Int      @default(0)
  rankCheckCount      Int      @default(0)
  revenueReportCount  Int      @default(0)
  trendsResearchCount    Int   @default(0)
  videoOptimizationCount Int   @default(0)
  channelAuditCount      Int   @default(0)
  hashtagGenCount        Int   @default(0)
  uploadTimeCount        Int   @default(0)
  channelComparisonCount Int   @default(0)
  breakoutVideoCount     Int   @default(0)
  topCreatorsCount       Int   @default(0)

  @@unique([userId, date])
  @@map("usage_daily")
}

model TagGeneration {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  source    ToolSource @default(youtube)
  tagsJson  Json
  createdAt DateTime   @default(now())

  @@index([userId])
  @@map("tag_generations")
}

model KeywordSearch {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyword         String
  volume          Int?
  difficulty      Int?
  competition     Float?
  viabilityScore  Float?
  relatedJson     Json     @default("[]")
  createdAt       DateTime @default(now())

  @@index([userId])
  @@map("keyword_searches")
}

model KeywordList {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime       @default(now())
  keywords  SavedKeyword[]

  @@map("keyword_lists")
}

model SavedKeyword {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyword     String
  listId      String?
  list        KeywordList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  metricsJson Json         @default("{}")
  createdAt   DateTime     @default(now())

  @@map("saved_keywords")
}

model RankCheck {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String
  keyword   String
  source    String?
  position  Int?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("rank_checks")
}

model RevenueReport {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId         String
  channelTitle      String
  channelThumbnail  String?
  channelStartDate  DateTime?
  channelDescription String?
  channelCountry    String?
  channelCustomUrl  String?
  contactEmail      String?
  socialLinksJson   Json     @default("[]")
  category          String?
  subscriberCount   Float?
  totalViewCount    Float?
  videoCount        Int?
  avgViewsRecent    Float?
  estMonthlyViews   Float?
  estRevenueLowUsd  Int?
  estRevenueHighUsd Int?
  recentVideosJson  Json     @default("[]")
  createdAt         DateTime @default(now())

  @@index([userId])
  @@map("revenue_reports")
}

model TrendSearch {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  region       String
  categoryId   String?
  categoryName String?
  language     String?
  resultsJson  Json     @default("[]")
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("trend_searches")
}

model TopCreatorsSearch {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  region       String
  categoryId   String?
  categoryName String?
  resultsJson  Json     @default("[]")
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("top_creators_searches")
}

model VideoOptimization {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId        String
  videoTitle     String
  videoThumbnail String?
  score          Int
  checklistJson  Json     @default("[]")
  detailsJson    Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([userId])
  @@map("video_optimizations")
}

model ChannelAudit {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId        String
  channelTitle     String
  channelThumbnail String?
  score            Int
  metricsJson      Json     @default("{}")
  findingsJson     Json     @default("[]")
  recentVideosJson Json     @default("[]")
  createdAt        DateTime @default(now())

  @@index([userId])
  @@map("channel_audits")
}

model HashtagGeneration {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query        String
  hashtagsJson Json     @default("[]")
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("hashtag_generations")
}

model BestUploadTime {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId          String
  channelTitle       String
  channelThumbnail   String?
  bestDay            String?
  bestHourUtc        Int?
  breakdownJson      Json     @default("[]")
  createdAt          DateTime @default(now())

  @@index([userId])
  @@map("best_upload_times")
}

model ChannelComparison {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelAId     String
  channelATitle  String
  channelBId     String
  channelBTitle  String
  comparisonJson Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([userId])
  @@map("channel_comparisons")
}

model BreakoutVideo {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId        String
  channelTitle     String
  channelThumbnail String?
  avgViews         Float?
  breakoutsJson    Json     @default("[]")
  createdAt        DateTime @default(now())

  @@index([userId])
  @@map("breakout_videos")
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  bodyMd      String
  coverUrl    String?
  status      String    @default("draft") // draft | published
  publishedAt DateTime?
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id])

  @@map("blog_posts")
}

model PageContent {
  id          String @id @default(cuid())
  key         String @unique // e.g. "landing", "legal.terms"
  contentJson Json

  @@map("pages_content")
}

model Faq {
  id        String  @id @default(cuid())
  question  String
  answer    String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  @@map("faqs")
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String
  metaJson   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String
  level     String    @default("info") // info | warning | critical
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean   @default(true)

  @@map("announcements")
}

enum SettingCategory {
  youtube
  razorpay
  google_oauth
  redis
  adsense
  admin
  email
  analytics
}

model SystemSetting {
  key         String          @id // e.g. "YOUTUBE_API_KEY"
  value       String? // stored as plain text — see admin/config page for the security caveat
  category    SettingCategory
  label       String
  isSecret    Boolean         @default(true)
  description String?
  updatedAt   DateTime        @updatedAt
  updatedBy   String?

  @@map("system_settings")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  page      String?
  message   String
  emailSent Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("feedback")
}
